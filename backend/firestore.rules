rules_version = '2';
// Reglas de Cloud Firestore para producción.
// La app nunca accede directo a Firestore: todo pasa por el backend Ktor, que usa el
// Admin SDK (no depende de estas reglas). Por eso se cierra el acceso a cualquier cliente.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
