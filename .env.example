# Opcional: copia este archivo como .env solo si necesitas cambiar algo.
# Expo solo expone a la app las variables que empiezan por EXPO_PUBLIC_.
# Después de cambiar .env reinicia Expo con: npx expo start -c

# URL base del backend Ktor (carpeta backend/, puerto 8080).
# Si no se define, la app usa automáticamente la IP del computador que ejecuta Expo
# (sirve para celular físico y emulador). Defínela solo si el backend está en otro equipo.
# EXPO_PUBLIC_API_URL=http://192.168.1.20:8080/api

# true = datos simulados (no necesita backend). Por defecto la app usa la API real.
EXPO_PUBLIC_USE_MOCK=false
