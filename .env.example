# Copia este archivo como .env y ajusta los valores.
# Expo solo expone a la app las variables que empiezan por EXPO_PUBLIC_.

# URL base del backend en Ktor (siguiente entrega).
# 10.0.2.2 = localhost del computador visto desde el emulador de Android.
# En un celular físico usa la IP local del computador, p. ej. http://192.168.1.20:8080/api
EXPO_PUBLIC_API_URL=http://10.0.2.2:8080/api

# true = datos simulados (no necesita backend). false = usa la API real.
EXPO_PUBLIC_USE_MOCK=true
